{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Sanitized ARM template for the BallotOnline VM Scale Set (670PoCScaleSet). Reconstructed from the portal configuration; not the original exported file."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region. The proof of concept used West US 3."
      }
    },
    "vmssName": {
      "type": "string",
      "defaultValue": "670PoCScaleSet",
      "metadata": {
        "description": "Name of the VM Scale Set."
      }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_B2ats_v2",
      "metadata": {
        "description": "Size of each scale set instance."
      }
    },
    "instanceCount": {
      "type": "int",
      "defaultValue": 2,
      "minValue": 1,
      "maxValue": 2,
      "metadata": {
        "description": "Number of instances. The proof of concept used min 1, default 2, max 2."
      }
    },
    "zones": {
      "type": "array",
      "defaultValue": [ "1", "2", "3" ],
      "metadata": {
        "description": "Availability zones to spread instances across."
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "azureuser",
      "metadata": {
        "description": "Linux administrator username."
      }
    },
    "sshPublicKey": {
      "type": "string",
      "metadata": {
        "description": "SSH public key, supplied at deployment time."
      }
    },
    "imageVersionResourceId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the 670PoCImage version in Azure Compute Gallery."
      }
    },
    "subnetResourceId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the subnet for the scale set instances."
      }
    },
    "loadBalancerBackendPoolId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the CCS670LB backend address pool."
      }
    },
    "customData": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional base64-encoded bootstrap script run by cloud-init at first boot (for example vmss-user-data.sh)."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Compute/virtualMachineScaleSets",
      "apiVersion": "2024-03-01",
      "name": "[parameters('vmssName')]",
      "location": "[parameters('location')]",
      "zones": "[parameters('zones')]",
      "sku": {
        "name": "[parameters('vmSize')]",
        "tier": "Standard",
        "capacity": "[parameters('instanceCount')]"
      },
      "properties": {
        "orchestrationMode": "Uniform",
        "upgradePolicy": {
          "mode": "Manual"
        },
        "virtualMachineProfile": {
          "storageProfile": {
            "imageReference": {
              "id": "[parameters('imageVersionResourceId')]"
            },
            "osDisk": {
              "createOption": "FromImage",
              "caching": "ReadWrite",
              "managedDisk": {
                "storageAccountType": "StandardSSD_LRS"
              }
            }
          },
          "osProfile": {
            "computerNamePrefix": "bo-web",
            "adminUsername": "[parameters('adminUsername')]",
            "customData": "[if(empty(parameters('customData')), null(), parameters('customData'))]",
            "linuxConfiguration": {
              "disablePasswordAuthentication": true,
              "ssh": {
                "publicKeys": [
                  {
                    "path": "[concat('/home/', parameters('adminUsername'), '/.ssh/authorized_keys')]",
                    "keyData": "[parameters('sshPublicKey')]"
                  }
                ]
              }
            }
          },
          "networkProfile": {
            "networkInterfaceConfigurations": [
              {
                "name": "ballotonline-nic",
                "properties": {
                  "primary": true,
                  "ipConfigurations": [
                    {
                      "name": "internal",
                      "properties": {
                        "subnet": {
                          "id": "[parameters('subnetResourceId')]"
                        },
                        "loadBalancerBackendAddressPools": [
                          {
                            "id": "[parameters('loadBalancerBackendPoolId')]"
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          },
          "extensionProfile": {
            "extensions": [
              {
                "name": "HealthExtension",
                "properties": {
                  "publisher": "Microsoft.ManagedServices",
                  "type": "ApplicationHealthLinux",
                  "typeHandlerVersion": "1.0",
                  "autoUpgradeMinorVersion": true,
                  "settings": {
                    "protocol": "http",
                    "port": 80,
                    "requestPath": "/"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "outputs": {
    "vmScaleSetName": {
      "type": "string",
      "value": "[parameters('vmssName')]"
    },
    "configuredInstanceCount": {
      "type": "int",
      "value": "[parameters('instanceCount')]"
    }
  }
}
